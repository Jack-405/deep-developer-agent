# =============================================================================
# Deep Developer Agent 配置示例
#
# 用法：复制本文件为 .env，填入你的配置：
#     copy .env.example .env        # Windows
#     cp .env.example .env          # Linux / macOS
#
# 所有配置均为可选项，未配置时使用默认值，agent 照常启动。
# =============================================================================

# -----------------------------------------------------------------------------
# 模型（必填：未配置则 CLI 启动时按默认空值构建，通常需要设置后才能对话）
# -----------------------------------------------------------------------------
MODEL_NAME=your-model-name
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-your-api-key

# -----------------------------------------------------------------------------
# 内置 MCP 适配器（可选，默认启用；依赖就绪时自动加载，缺失时自动降级跳过）
# -----------------------------------------------------------------------------
# Godot 开发支持（需要 vendor/godot-ai，见 README「安装可选组件」）
# DEEPDEV_GODOT_ENABLED=true
# DEEPDEV_GODOT_AI_DIR=
# DEEPDEV_GODOT_PROJECT_PATH=
# DEEPDEV_GODOT_PORT=8000
# DEEPDEV_GODOT_WS_PORT=9500

# Obsidian 笔记库（需要 obsidian-mcp 二进制，见 README「安装可选组件」）
# OBSIDIAN_ENABLED=true
# OBSIDIAN_BIN=
# OBSIDIAN_VAULT_PATH=

# -----------------------------------------------------------------------------
# 通用 MCP 接入（无需改代码，配置即插即用）
#
# DEEPDEV_MCP_EXTRA 是一个 JSON 数组字符串，每项声明一个 stdio MCP server：
#   {
#     "name":        "server 名（工具前缀 / 冲突改名用，必填）",
#     "scope":       "global | workspace",   # 默认 global
#     "command":     "可执行文件（绝对路径或 PATH 中的名字，必填）",
#     "args":        ["arg1", "arg2"],       # 可选
#     "env":         {"KEY": "value"},       # 可选，附加环境变量
#     "enabled":     true,                    # 可选，默认 true
#     "prompt":      "给 agent 的使用引导文本",  # 可选，内联提示词
#     "prompt_file": "path/to/prompt.md"      # 可选，提示词文件（相对项目根）
#   }
#
# 示例 1：用 npx 启动任意 MCP server（global 作用域，启动即加载）
# DEEPDEV_MCP_EXTRA=[{"name":"my-mcp","scope":"global","command":"npx","args":["-y","@some/mcp-server"]}]
#
# 示例 2：多 server 用逗号分隔，每个都可带独立 env / prompt
# DEEPDEV_MCP_EXTRA=[
#   {"name":"a","command":"C:\\tools\\a-mcp.exe","args":["--port","8080"]},
#   {"name":"b","scope":"workspace","command":"python","args":["-m","b_mcp"],"enabled":false}
# ]
#
# 注意：JSON 中的反斜杠需转义为双反斜杠；.env 单行太长时可跨行写
# （示例 2 写法）。解析失败只告警并跳过该项，不影响启动。
# -----------------------------------------------------------------------------
# DEEPDEV_MCP_EXTRA=[]

# -----------------------------------------------------------------------------
# 日志（可选）
# -----------------------------------------------------------------------------
# DEEPDEV_LOG_LEVEL=INFO
# DEEPDEV_LOG_FILE=logs/deepdev.jsonl
